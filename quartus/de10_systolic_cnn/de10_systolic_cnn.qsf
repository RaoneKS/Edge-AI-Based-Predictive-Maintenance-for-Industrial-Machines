# DE10-Standard implementation of cnn_inference_top through the 8x8 systolic adapter.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de10_systolic_cnn_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE de10_systolic_cnn.sdc

set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/pkg_accelerator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/mac_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/systolic_array.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cnn_systolic_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cnn_inference_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE de10_systolic_cnn_top.sv

# Model ROM files are generated by verification/scripts/prepare_de10_model_data.py.
set_global_assignment -name SEARCH_PATH ../de10_standard_hw/model_data

# Terasic DE10-Standard board I/O.
set_location_assignment PIN_AF14 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_location_assignment PIN_AJ4 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_location_assignment PIN_AB30 -to SW[0]
set_instance_assignment -name IO_STANDARD "2.5 V" -to SW[0]
set_location_assignment PIN_Y27 -to SW[1]
set_instance_assignment -name IO_STANDARD "2.5 V" -to SW[1]

set_location_assignment PIN_AA24 -to LEDR[0]
set_location_assignment PIN_AB23 -to LEDR[1]
set_location_assignment PIN_AC23 -to LEDR[2]
set_location_assignment PIN_AD24 -to LEDR[3]
set_location_assignment PIN_AG25 -to LEDR[4]
set_location_assignment PIN_AF25 -to LEDR[5]
set_location_assignment PIN_AE24 -to LEDR[6]
set_location_assignment PIN_AF24 -to LEDR[7]
set_location_assignment PIN_AB22 -to LEDR[8]
set_location_assignment PIN_AC22 -to LEDR[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to LEDR
set_instance_assignment -name SLEW_RATE 0 -to LEDR

set_global_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS"

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"